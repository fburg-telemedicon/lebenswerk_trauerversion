{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/demobuch", "destination": "https://bniwrvfjqewjlzruslnd.supabase.co/storage/v1/object/public/Demo_books/Gedenkbuch_V2_Ingrid_Wagner_Demo_Druck.pdf" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/ask.js":                  { "maxDuration": 60 },
    "api/admin/generate-image.js": { "maxDuration": 60 },
    "api/admin/compose-image.js":  { "maxDuration": 60, "includeFiles": "api/_fonts/**" },
    "api/transcribe.js":           { "maxDuration": 30 },
    "api/cron/purge.js":           { "maxDuration": 60 }
  }
}
